{
  "name": "cruxcare-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-native-biometric-gradle.mjs && node scripts/patch-android-push-and-monnify.mjs",
    "patch:android": "node scripts/patch-android-push-and-monnify.mjs",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:emulator": "vue-tsc && vite build --mode emulator",
    "build:device": "vue-tsc && vite build --mode device",
    "build:remote": "vue-tsc && vite build --mode remote",
    "sync:android:emulator": "npm run build:emulator && npx cap sync android && npm run patch:android",
    "sync:android:device": "npm run build:device && npx cap sync android && npm run patch:android",
    "sync:android:remote": "npm run build:remote && npx cap sync android && npm run patch:android",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@cruxcare/capacitor-monnify": "file:packages/capacitor-monnify",
    "@daily-co/daily-js": "0.93.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.19.0",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "ionicons": "^7.0.0",
    "material-symbols": "^0.45.10",
    "pinia": "^4.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.3.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@pinia/testing": "^2.0.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
