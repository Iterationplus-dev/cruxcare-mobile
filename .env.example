# Base URL for the Laravel /api/v1 gateway. Points at nothing real yet —
# see src/mocks for the MSW fixtures that stand in until a backend exists.
VITE_API_BASE_URL=https://api.cruxcare.example/api/v1

# When true, API calls are served by the MSW mock layer (src/mocks) instead
# of the real network. Keep true until a real backend is available.
VITE_USE_API_MOCKS=true

# Realtime (Laravel Echo/Reverb) connection — unused while mocked.
VITE_ECHO_HOST=
VITE_ECHO_KEY=

# --- Payments (Monnify) -----------------------------------------------------
# `monnify` selects the native/hosted Monnify checkout; anything else keeps the
# mock provider, which always approves and must never point at a real API.
VITE_PAYMENT_PROVIDER=mock

# Public merchant identifiers from the Monnify dashboard. They are a FALLBACK:
# POST /payments/intents returns a `gateway` block that takes precedence, so
# keys can rotate without an app release.
# The Monnify SECRET key is server-only. Never put it in a VITE_ variable —
# every VITE_ value is inlined into the shipped JavaScript bundle.
VITE_MONNIFY_API_KEY=
VITE_MONNIFY_CONTRACT_CODE=
# LIVE moves real money. Anything else (including unset) stays on the sandbox.
VITE_MONNIFY_MODE=TEST
