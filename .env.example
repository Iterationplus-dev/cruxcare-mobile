# Base URL for the Laravel /api/v1 gateway. Points at nothing real yet —
# see src/mocks for the MSW fixtures that stand in until a backend exists.
VITE_API_BASE_URL=https://api.cruxcare.example/api/v1

# When true, API calls are served by the MSW mock layer (src/mocks) instead
# of the real network. Keep true until a real backend is available.
VITE_USE_API_MOCKS=true

# Realtime (Laravel Echo/Reverb) connection — unused while mocked.
VITE_ECHO_HOST=
VITE_ECHO_KEY=

VITE_MONNIFY_API_KEY=
VITE_MONNIFY_CONTRACT_CODE=