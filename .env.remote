# Build against the hosted CruxCare API, for installing on any phone without
# a USB tunnel or a local Laragon. This file is loaded only with --mode remote.
VITE_API_BASE_URL=https://app.cruxcintl.com/api/v1
VITE_USE_API_MOCKS=false

# Merchant credentials come from .env; see .env.emulator for why they are not
# repeated here. LIVE moves real money — anything else stays on the sandbox.
VITE_PAYMENT_PROVIDER=monnify
VITE_MONNIFY_MODE=TEST
