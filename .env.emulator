# Android Emulator maps the development host to 10.0.2.2 rather than the
# Windows-only cci.test hostname. This file is loaded only with --mode emulator.
VITE_API_BASE_URL=http://10.0.2.2/api/v1
# Laragon selects the CCI site by virtual-host name. Capacitor's native HTTP
# bridge can send this header while connecting to the emulator host gateway.
VITE_API_HOST_HEADER=cci.test
VITE_USE_API_MOCKS=false
