# Android Emulator maps the development host to 10.0.2.2 rather than the
# Windows-only cci.test hostname. This file is loaded only with --mode emulator.
VITE_API_BASE_URL=http://10.0.2.2/api/v1
# Laragon selects the CCI site by virtual-host name. Capacitor's native HTTP
# bridge can send this header while connecting to the emulator host gateway.
VITE_API_HOST_HEADER=cci.test
VITE_USE_API_MOCKS=false

# --- Payments ---------------------------------------------------------------
# Opens Monnify's real checkout sheet on tap. Without this the mock provider is
# selected, which approves without opening anything — useless for testing a
# payment and dangerous against a real API.
VITE_PAYMENT_PROVIDER=monnify
# Merchant credentials live in .env, which this file must not blank out:
# Vite loads .env first and lets a mode file override it, so an empty
# VITE_MONNIFY_API_KEY here would win and leave the build with no keys.
# The `gateway` block from POST /payments/intents still takes precedence
# over both at runtime.
# LIVE moves real money. Anything else, including unset, stays on the sandbox.
VITE_MONNIFY_MODE=TEST
