# Build for a USB-connected physical phone.
#
# 10.0.2.2 is the emulator's alias for this machine and means nothing on real
# hardware, so the phone reaches the API through an adb reverse tunnel instead:
#
#   adb reverse tcp:8080 tcp:80
#
# That maps port 8080 on the handset back to port 80 here, over the USB cable —
# no LAN address, no firewall rule, and it keeps working when the laptop moves
# between networks. The Host header is what picks the cci.test vhost out of
# Laragon, exactly as it does for the emulator.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_HOST_HEADER=cci.test
VITE_USE_API_MOCKS=false
VITE_PAYMENT_PROVIDER=monnify
VITE_MONNIFY_MODE=TEST
