# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www
/ios
/android/*
!/android/gradle.properties
.env
tests/e2e/videos
tests/e2e/screenshots

# Gradle output for the local Capacitor plugin(s) in packages/
/packages/*/android/build
/packages/*/android/.gradle

# Firebase client config belongs in android/app/, never in public/ — anything
# in public/ is copied verbatim into dist/ and into the APK's web assets, and
# is served publicly by the web build.
/public/google-services.json
